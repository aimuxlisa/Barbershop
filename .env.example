# ============================================================
#  Visual Site Builder — environment variables
#  Скопируйте этот файл в .env (локально) и заполните значения.
#  В GitHub ничего секретного не попадает: .env / .env.local
#  добавлены в .gitignore.
# ============================================================

# --- AI page synthesis (server route: POST /api/ai) ------------
# Без ключа API отвечает 503 AI_NOT_CONFIGURED, а AI-модалка
# автоматически переключается на локальную синтез-функцию
# (сайт при этом работает полностью).
# Ключ задаётся ТОЛЬКО на сервере (Vercel → Settings →
# Environment Variables), в браузер он не попадает.
AI_API_KEY=
# Любой OpenAI-совместимый endpoint (OpenAI / OpenRouter / proxied):
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# --- Public site URL -------------------------------------------
# Используется при экспорте ZIP: sitemap.xml и robots.txt
# (подставляется вместо дефолтного https://example.com).
# Для Vercel: https://<project-name>.vercel.app
NEXT_PUBLIC_SITE_URL=https://example.com
